{
  "name": "packshift",
  "private": true,
  "version": "0.5.1",
  "description": "PACKSHIFT — a spatial packaging constraint compiler (Blender master + React Three Fiber).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "validate:glb": "python3 scripts/validate_glb_contract.py",
    "validate:blender": "python3 blender/scripts/validate_contract.py",
    "check": "npm test && npm run validate:glb && npm run validate:blender && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@react-three/drei": "^10.0.7",
    "@react-three/fiber": "^9.1.2",
    "gsap": "^3.13.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.176.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "vite": "^6.3.5"
  }
}
